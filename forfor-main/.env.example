# WooCommerce REST API base URL, for example:
# https://your-store.com/wp-json/wc/v3
VITE_WOOCOMMERCE_API_URL=

# Create a read-only or read/write key in WooCommerce > Settings > Advanced > REST API.
# Do not commit real values or send them in chat.
VITE_WOOCOMMERCE_CONSUMER_KEY=
VITE_WOOCOMMERCE_CONSUMER_SECRET=

# Public storefront URL used for account and checkout redirects.
VITE_WOOCOMMERCE_STORE_URL=https://your-store.com
